# Backend
PORT=3101
CORS_ORIGIN=http://localhost:4301

# PostgreSQL
DB_HOST=localhost
DB_PORT=5443
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
# Never true: the schema is created by migrations (npm run migration:run).
DB_SYNCHRONIZE=false

# AI adapter — any OpenAI-compatible endpoint (LiteLLM, Azure OpenAI,
# Scaleway, Ollama...). Leave AI_API_KEY empty to disable the AI; the app
# still boots and only the AI features fall back.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemma-4-31B-it
AI_TIMEOUT_MS=60000

# Where the chat's wellbeing notice links to (AIB-03). Leave empty for
# https://findahelpline.com.
SUPPORT_URL=

# Game tunables (SD section 11). Leave a value empty to use the SD default.
GAME_MAX_PLANTS=
GAME_CLOUD_REFILL_SECONDS=
GAME_CLOUD_COUNT=
GAME_CLOUD_DRIFT_DEGREES_PER_MINUTE=
GAME_RAIN_SECONDS=
GAME_RAIN_RADIUS_STEPS=
GAME_RAIN_WATER_PER_SECOND=
GAME_SUN_OVERRIDE_MINUTES=
GAME_SUN_DAY_MINUTES=
GAME_UNMET_NEED_GROWTH_FACTOR=
GAME_SEEDS_PER_HARVEST_MIN=
GAME_SEEDS_PER_HARVEST_MAX=
GAME_HARVEST_COOLDOWN_MINUTES=
GAME_STARTER_SEED_TYPES=
GAME_ARRIVAL_DELAY_SECONDS=
GAME_ARRIVAL_SPACING_MINUTES=
GAME_MAX_CREATURES=
GAME_MAX_PER_SPECIES=
GAME_OVERJOYED_GIFT_HOURS=
GAME_WANT_COOLDOWN_MINUTES=
GAME_UNLOCK_EVERY_N_REWARDS=
GAME_CHAT_MESSAGE_MAX_CHARS=
GAME_CHAT_ANSWER_MAX_WORDS=
GAME_AI_TIMEOUT_MS=
GAME_CHAT_DAILY_LIMIT=
GAME_MAX_AWAY_DAYS=
GAME_SUMMARY_AFTER_MINUTES=
GAME_JOURNAL_AFTER_HOURS=
GAME_JOURNAL_MAX_WORDS=
GAME_SYNC_INTERVAL_SECONDS=
GAME_PLANET_NAME_MIN=
GAME_PLANET_NAME_MAX=
