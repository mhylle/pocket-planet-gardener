# Backend
PORT=3101
CORS_ORIGIN=http://localhost:4301

# PostgreSQL
DB_HOST=localhost
DB_PORT=5443
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
# Never true: the schema is created by migrations (npm run migration:run).
DB_SYNCHRONIZE=false

# AI adapter — any OpenAI-compatible endpoint (LiteLLM, Azure OpenAI,
# Scaleway, Ollama...). Leave AI_API_KEY empty to disable; the app still
# boots and only sending a message reports 503.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemma-4-31B-it
AI_TIMEOUT_MS=60000
